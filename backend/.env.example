# PostgreSQL connection
DATABASE_URL=postgresql+asyncpg://olt:oltpassword@localhost:5432/olt_commander

# JWT auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Default admin account created on first start (if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# CORS origins for the frontend (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Polling intervals (seconds). Set to 0 to disable periodic scanning.
SCAN_OLT_INTERVAL=300
SCAN_MIKROTIK_INTERVAL=300
BIND_INTERVAL=300